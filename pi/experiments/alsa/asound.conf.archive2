# Raspberry Pi Zero W 2 with HiFiBerry DAC + alsaequal Configuration
# Audio chain: sources → softvol → dmix → equal → hardware

# 1. Define the hardware device
pcm.hifiberry_hw {
    type hw
    card 0
    device 0
}

# 2. Set up the equalizer
ctl.equal {
    type equal
}

pcm.plugequal {
    type equal
    slave.pcm "plughw:0,0"
}

# 3. Set up dmix for mixing multiple streams
pcm.dmixer {
    type dmix
    ipc_key 1024
    ipc_perm 0666
    slave {
        pcm "hw:0,0"  # dmix must connect directly to hw
        channels 2
        rate 44100
        format S16_LE
        period_size 1024
        buffer_size 8192
    }
}

# 4. Create a routed dmix that goes through the EQ
pcm.dmixer_eq {
    type plug
    slave.pcm plugequal
}

# 5. Software volume controls for different sources
pcm.softvol_librespot {
    type softvol
    slave.pcm "dmixer"
    control {
        name "Librespot"
        card 0
    }
}

pcm.softvol_snapcast {
    type softvol
    slave.pcm "dmixer"
    control {
        name "Snapcast"
        card 0
    }
}

pcm.softvol_system {
    type softvol
    slave.pcm "dmixer"
    control {
        name "System"
        card 0
    }
}

# 6. Convenient aliases for each source
pcm.librespot {
    type plug
    slave.pcm "softvol_librespot"
}

pcm.snapcast {
    type plug
    slave.pcm "softvol_snapcast"
}

pcm.system {
    type plug
    slave.pcm "softvol_system"
}

# 7. Default device routes through system volume
pcm.!default {
    type plug
    slave.pcm "softvol_system"
}

# 8. Default control device
ctl.!default {
    type hw
    card 0
}

# Optional: Direct access to EQ for testing
pcm.eq_direct {
    type plug
    slave.pcm plugequal
}
