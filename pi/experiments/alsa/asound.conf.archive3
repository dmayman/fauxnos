# Define the hardware device
pcm.hifiberry_hw {
    type hw
    card 0
    device 0
}

# Default device
pcm.!default {
    type plug
    slave.pcm plugequal
}

# Default control device
ctl.!default {
    type hw
    card 0
}

ctl.equal {
    type equal
}

# Define equalizer
pcm.plugequal {
    type equal
    slave.pcm "dmixer"
}

pcm.equal {
    type plug
    slave.pcm plugequal
}

# System device
pcm.system {
    type softvol
    slave.pcm "dmixer"
    control {
        name "System"
        card 0
    }
}

# All Sources device (to be used by Snapclient, Librespot, Analog In)
# pcm.sources {
#     type softvol
#     slave.pcm "plugequal"
#     control {
#         name "All Sources"
#         card 0
#     }
# }







# Equalizer control
ctl.equal {
    type equal
}

# Set up the dmixer for combining All Sources+EQ and System
pcm.dmixer {
    type dmix
    ipc_key 1024
    ipc_perm 0666
    slave {
        pcm "hifiberry_hw"
        period_size 1024
        buffer_size 8192
        rate 44100
        format S16_LE
        channels 2
    }
}