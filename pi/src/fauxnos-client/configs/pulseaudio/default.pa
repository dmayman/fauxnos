.include /etc/pulse/default.pa

# --- Keep the DAC awake ---
# /etc/pulse/default.pa loads module-suspend-on-idle, which suspends any
# sink (including the hardware ALSA output) after 5s of silence. On a
# HiFiBerry DAC+ADC that costs ~5s of wake-up latency the next time we
# play a feedback sound — the user hears nothing on the first IR press
# until the chip comes back online. Unloading the module trades that
# latency for negligible idle power draw on a permanently-powered audio
# device. If you ever hear hiss from an always-on DAC, swap this for a
# silent-stream pre-warm or a longer suspend timeout instead.
unload-module module-suspend-on-idle

# --- Custom PulseAudio Configuration for HiFiBerry DAC+ADC ---

# Important: Disable timer-based scheduling for improved stability on Raspberry Pi
# This line must come AFTER the .include /etc/pulse/default.pa and BEFORE any sinks/sources are loaded
# Replace '0' with the actual device ID of your HiFiBerry DAC if it's not the first one (0).
# You can find it with 'aplay -l'
load-module module-alsa-card device_id=0 tsched=0

# --- Virtual Sinks ---
# These act as entry points for different audio sources.
# load-module module-null-sink sink_name=spotifysink sink_properties="device.description='Spotify Output'"
load-module module-null-sink sink_name=systemsink sink_properties="device.description='System Sounds'"
load-module module-null-sink sink_name=analogsink sink_properties="device.description='Analog Loopback'"
load-module module-null-sink sink_name=snapsink sink_properties="device.description='Snapcast Output'"
# airplaysink — shairport-sync writes here when an AirPlay session is
# active. The fauxnos source manager mutes/unmutes it just like the
# other virtual sinks. shairport's software volume on the PCM stream
# is the single user-control stage; fauxnos pins this sink at 100%
# while airplay is the active source so the externally-attenuated
# audio passes through transparently.
load-module module-null-sink sink_name=airplaysink sink_properties="device.description='AirPlay Output'"

# --- Analog Input Loopback ---
# Pipes your analog input directly to the 'analogsink' virtual sink.
# Removed the aggressive latency_msec=1. PulseAudio will now use system defaults.
# sink_input_properties=media.role=fauxnos-analog-input gives this loopback
# a stable role tag so the calibration code can find it via `pactl list sink-inputs`.
# On clients without an ADC the source won't exist and PulseAudio will skip the
# load — that's harmless.
#
# latency_msec=80 (was 20): see the per-source loopback block below for the
# full rationale. The HiFiBerry DAC+ADC ALSA source clamps to a 59.95 ms
# minimum anyway (PA logs "Cannot set requested source latency of 6.67 ms,
# adjusting to 59.95 ms" at startup) so the practical floor here is ~60 ms;
# 80 lines this loopback up with the camilla_input ones for consistency.
load-module module-loopback source="alsa_input.platform-soc_sound.stereo-fallback" sink=analogsink latency_msec=80 sink_input_properties=media.role=fauxnos-analog-input

# --- CamillaDSP Capture Sink ---
# Final intermediate sink before audio enters the DSP engine. All
# per-source loopbacks below write here; CamillaDSP captures
# camilla_input.monitor (its WebSocket on 127.0.0.1:1234 lets the
# fauxnos-client push live filter updates), applies the filter pipeline
# from ~/.config/camilladsp/config.yml, then plays out to alsa_output.
#
# A previous attempt used module-ladspa-sink with mbeq_1197; that path
# is a dead end because PA exposes no DBUS surface for LADSPA controls,
# so live slider updates would require module reload (audio glitch).
# module-equalizer-sink is upstream-disowned in PA 16.1 ("currently
# unsupported, can cause crashes/latency/artifacts" per its own log
# warning). CamillaDSP is the actively-maintained, designed-for-live-
# reload alternative.
#
# Loading this sink with no consumer attached is harmless: loopback
# audio just gets dropped at camilla_input until camilladsp.service is
# up. After=pulseaudio.service + Restart=on-failure on the systemd unit
# handles the PA-restart → ~10s gap → recovery flow.
load-module module-null-sink sink_name=camilla_input sink_properties="device.description='CamillaDSP Input'"

# --- Per-source loopbacks into CamillaDSP ---
# These take the *monitor output* of each virtual sink and write into
# camilla_input (the DSP capture sink above). Each loopback carries a
# stable sink_input_properties.media.role so
# pulse_controller.set_loopback_calibration() can find it and use it as
# a per-source pre-amp ceiling. Routing target is camilla_input rather
# than alsa_output directly so the end-of-chain EQ touches every
# source uniformly (snapcast / airplay / system sounds / analog).
#
# latency_msec=80 (was 20): on a Pi Zero 2 W, five simultaneous
# loopbacks all converging on camilla_input with a 20 ms request cannot
# hold their schedule. PA's adaptive resampler thrashes (loopback rates
# observed drifting to 43951–44083 Hz instead of 44100), CPU pegs near
# 78 %, and within ~13 s of PA startup the journal shows
# "Too many underruns, increasing latency to N ms" ramping in 5 ms steps
# until N hits 90.75 ms — which it never recovered from in practice
# (audio fell progressively behind for hours, remote control queued
# behind PA's main thread). 80 ms gives PA enough budget to satisfy all
# five loopbacks plus CamillaDSP's capture without underrun cascades.
# Net cost: ~60 ms of added end-to-end latency, imperceptible relative
# to a healthy chain; the unhealthy chain was effectively unbounded.
#
# A default.pa edit only takes effect after PA restart, so install.sh
# below mark_reboot_needed's any time this file's mtime is newer than
# the running PA process. See [feedback_eq_dsp_rules.md].
# load-module module-loopback source=spotifysink.monitor sink=camilla_input latency_msec=80
load-module module-loopback source=systemsink.monitor sink=camilla_input latency_msec=80 sink_input_properties=media.role=fauxnos-systemsink-out
load-module module-loopback source=analogsink.monitor sink=camilla_input latency_msec=80 sink_input_properties=media.role=fauxnos-analogsink-out
load-module module-loopback source=snapsink.monitor sink=camilla_input latency_msec=80 sink_input_properties=media.role=fauxnos-snapsink-out
load-module module-loopback source=airplaysink.monitor sink=camilla_input latency_msec=80 sink_input_properties=media.role=fauxnos-airplaysink-out

# --- Application Routing ---
# Automatically route specific applications to their designated sinks
# This ensures apps go to the correct sink regardless of default sink setting
# load-module module-match-properties on_client_disconnect=dont-restore add_match_property="application.name=ALSA plug-in [snapclient]" sink=snapsink
# load-module module-match-properties on_client_disconnect=dont-restore add_match_property="application.name=ALSA plug-in [squeezelite]" sink=libresink

# --- Set Default Sink ---
# This makes 'spotifysink' the default. Applications that don't specify a sink
# will send their audio to 'spotifysink'. This audio will then be routed
# directly to the hardware output.
set-default-sink snapsink