[Unit]
Description=CamillaDSP — Fauxnos per-client end-of-chain equalizer
Documentation=https://github.com/HEnquist/camilladsp
# CamillaDSP needs PulseAudio's user-mode socket to capture from
# camilla_input.monitor (created by ~/.config/pulse/default.pa) and to
# play to alsa_output. PA is socket-activated, but a cold start where
# we beat PA to the punch wastes a Restart cycle — gate explicitly.
After=pulseaudio.service
Wants=pulseaudio.service

[Service]
Type=simple
# -a 127.0.0.1 binds the WebSocket control plane to loopback only
# (the fauxnos-client process talks to it locally; no remote access
# needed). -p 1234 is the conventional CamillaDSP port. The YAML is
# read on start AND written back by camilladsp on every SetConfigJson,
# so it doubles as runtime persistence (see install.sh's
# setup_camilladsp_config — install must NOT clobber it on re-runs).
ExecStart=/usr/local/bin/camilladsp -a 127.0.0.1 -p 1234 %h/.config/camilladsp/config.yml
# Restart=always (not on-failure): when PulseAudio restarts, the
# pulse_playback/pulse_capture devices throw "Connection terminated"
# and camilladsp's Rust main loop exits cleanly with status 0. With
# on-failure that clean exit is ignored and the service stays dead —
# audio falls silent on every source even though the chain looks
# otherwise healthy. Surfaced 2026-05-14 when a manual PA restart on
# fauxnos000 left camilladsp inactive for 38 minutes; PA was happily
# reloaded on the next snapclient connect, the 5 loopbacks all wrote
# into camilla_input, but nobody was capturing camilla_input.monitor.
#
# RestartSec=5 stays — gives PA's socket activation time to settle
# (camilladsp tries to capture from camilla_input.monitor immediately,
# and reconnecting to a half-warm PA was the original concern). A
# malformed YAML still exits non-zero, so the catastrophe scenario
# (Restart=always + broken config = journal-drowning restart loop)
# would happen even with on-failure; this change doesn't make it
# worse.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
