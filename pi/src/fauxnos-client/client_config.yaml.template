# Fauxnos Client Configuration
# =============================
# Copy this file to ~/.config/fauxnos/client_config.yaml and edit for your device

# Device identification
device:
  name: kitchen             # Unique device name (lowercase, no spaces)
  mac: "00:00:00:00:00:00"  # MAC address of this device
  display_name: Kitchen     # Human-readable name

# Server hostname (for snapcast and registration)
server_host: fauxnos000.local

# Audio sources
sources:
  # Internal source - Spotify via Snapcast
  - id: spotify
    label: Spotify
    type: internal
    sink: snapsink                   # PulseAudio sink name
    starting_volume: 50              # Default volume (0-100)
    volume_controller: snapcast      # 'self' or 'snapcast'

  # Internal source - AirPlay via Snapcast
  - id: airplay
    label: AirPlay
    type: internal
    sink: snapsink
    starting_volume: 50
    volume_controller: snapcast

  # Internal source - Analog input (only for devices with ADC hardware)
  # Remove this section if your device doesn't have an analog input
  - id: analog
    label: Analog In
    type: internal
    sink: analogsink
    starting_volume: 50
    volume_controller: self          # Use PA sink for volume control

# Logging configuration
logging:
  file: ~/logs/fauxnos-client.log
  level: INFO                        # DEBUG, INFO, WARNING, ERROR

# State file (stores current source and volumes)
state_file: ~/.config/fauxnos/client_state.json

# MQTT configuration (for remote control from web UI and other clients)
mqtt:
  broker_host: fauxnos000.local
  broker_port: 1883
  enabled: true
