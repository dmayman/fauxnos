# Fauxnos Client Configuration
# =============================
# Copy this file to ~/.config/fauxnos/client_config.yaml and edit for your device

# Device identification
device:
  name: kitchen             # Unique device name (lowercase, no spaces)
  mac: "00:00:00:00:00:00"  # MAC address of this device
  display_name: Kitchen     # Human-readable name

# Server hostname (for snapcast and registration)
server_host: fauxnos000.local

# go-librespot HTTP+WebSocket endpoint (optional). go-librespot runs
# on the server, one instance per client, on port 3600+N where N is
# the client number parsed from `fauxnos<NNN>`. If absent, derived:
# host = server_host, port = 3600 + N. Override here for non-standard
# topologies or testing.
# go_librespot:
#   host: fauxnos000.local
#   port: 3601

# Audio sources
#
# pa_calibration (0-100, default 100): a fixed pre-amp ceiling on the
# PA loopback for this source's sink. Used to normalize loudness across
# sources that have different inherent gain (Spotify often comes hot,
# analog input from a turntable might be quiet, etc.). Sources sharing
# a sink share the calibration. See docs/VOLUME.md.
sources:
  # Internal source - Spotify via go-librespot
  #
  # volume_controller=go_librespot: single-stage. go-librespot
  # attenuates (so the Spotify mobile-app slider mirrors what fauxnos
  # shows); snapcast + the PA sink both stay at 100% for this source.
  # See brief_spotify_volume_sync.md.
  - id: spotify
    label: Spotify
    type: internal
    sink: snapsink                   # PulseAudio sink name
    starting_volume: 50              # Default volume (0-100)
    volume_controller: go_librespot  # 'self', 'snapcast', 'go_librespot', or 'external'
    pa_calibration: 100              # Loopback ceiling 0-100; tune in UI later

  # Internal source - Analog input (only for devices with ADC hardware)
  # Remove this section if your device doesn't have an analog input
  - id: analog
    label: Analog In
    type: internal
    sink: analogsink
    starting_volume: 50
    volume_controller: self          # Use PA sink for volume control
    pa_calibration: 100

  # Internal source - AirPlay (always installed on every fauxnos device).
  # volume_controller=external puts the iPhone in sole control:
  # shairport-sync software-attenuates the PCM, fauxnos pins the PA
  # sink at 100% when active, and the UI surfaces a "Volume controlled
  # by iPhone" caption (fauxnos slider drags are no-ops on this source).
  # on_leave_command restarts shairport on switch-away so the iPhone's
  # RTSP session is dropped cleanly (otherwise it keeps streaming into
  # a muted sink indefinitely).
  - id: airplay
    label: AirPlay
    type: internal
    sink: airplaysink
    starting_volume: 50
    volume_controller: external
    pa_calibration: 100
    on_leave_command: "systemctl --user restart shairport-sync-fauxnos.service"

# Logging configuration
logging:
  file: ~/logs/fauxnos-client.log
  level: INFO                        # DEBUG, INFO, WARNING, ERROR

# State file (stores current source and volumes)
state_file: ~/.config/fauxnos/client_state.json

# MQTT configuration (for remote control from web UI and other clients)
mqtt:
  broker_host: fauxnos000.local
  broker_port: 1883
  enabled: true

# GPIO push-button controls (optional).
#
# Wire each momentary button between the listed GPIO pin and GND. The
# Pi's internal pull-up handles the rest — no external resistor needed.
# Default pin choices stay clear of HiFiBerry I2S/I2C (GPIO 2/3, 18-21)
# and the gpio-ir-recv overlay (GPIO 17).
#
# Flip enabled to true once the buttons are soldered on. Auto-repeat on
# hold is on for volume (so holding a button ramps the level the same
# way a held IR button does), off for source_cycle (cycling through
# sources rapidly is bad UX). Commands must be one of the canonical
# IR ids: volume_up, volume_down, mute, source_cycle, play_pause, next,
# previous — buttons share the IR dispatch table so they play the same
# feedback sounds and publish the same MQTT updates.
buttons:
  enabled: false
  bounce_time_ms: 50           # software debounce window
  hold_time_ms: 250            # delay before auto-repeat (matches IR repeat rate)
  pins:
    - gpio: 5                  # header pin 29
      command: volume_up
      hold_repeat: true
    - gpio: 6                  # header pin 31
      command: volume_down
      hold_repeat: true
    - gpio: 26                 # header pin 37
      command: source_cycle
      hold_repeat: false
