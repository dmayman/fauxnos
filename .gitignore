node_modules/
__pycache__/
*.pyc
.DS_Store
pi_backups/

# Local agent state
.claude/

# Audio source projects — large binary DAW project folders (Ableton / Logic).
# The bounced WAVs land in pi/src/fauxnos-client/sounds/ which IS tracked;
# the source projects themselves are too big and not needed by the build.
pi/sounds/
m4l-batch-locator-export/

# Runtime state — created from configs/server_config.json.template by
# config_manager.ConfigManager._ensure_config_exists() on first server
# startup. The live file accumulates registered clients, home_groups,
# deployed_sha tracking, etc. Tracking it in git would cause every
# `git pull` on a server to either clobber that state or hit a merge
# conflict on routine changes. The template is the canonical schema.
pi/src/fauxnos-server/server_config.json
